generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipType {
  FULL
  INTERNAL_ONLY
  GUEST
  // Full member of a *different* club, still KNSB-registered (has their own
  // knsbId) — plays here as a second-club member, not this club's own.
  SECONDARY
}

enum EntryKind {
  GAME
  PAIRING_BYE
  REGULAR_BYE
  EXTERNAL_BYE
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  WHITE_WIN_FORFEIT
  BLACK_WIN_FORFEIT
}

enum ExternalOutcome {
  WIN
  DRAW
  LOSS
}

enum Gender {
  M
  V
  X
}

// Club-wide identity. Never deleted — referenced by historical RoundEntry
// rows across seasons forever. Fix typos with an update, not a delete+recreate.
model Player {
  id             Int            @id @default(autoincrement())
  name           String
  membershipType MembershipType @default(FULL)
  notes          String?
  createdAt      DateTime       @default(now())
  // Jim's own dues-tracking flag — purely his bookkeeping, no effect on
  // scoring, eligibility, or anything else on the site.
  duesPaid       Boolean        @default(false)
  // Set when an admin archives someone who hasn't shown up in a long time —
  // purely a display/list-declutter flag, never touches enrollments or
  // historical RoundEntry rows. Null means active.
  archivedAt     DateTime?

  // KNSB rating-list submission fields. Always admin-editable regardless of
  // whether a player self-reports them — "some people don't know their own
  // number" (Jim). No birthdate field: the real submissions always use a
  // dummy 1900.01.01, nobody bothers entering real DOBs.
  gender     Gender?
  knsbId     String?
  // 3-letter federation code (NED/ESP/HUN/ENG/...), required by the KNSB spec
  // but deliberately no default here — a Guest never needs one filled in, and
  // silently defaulting it for every new player (including guests) was a bug.
  // Admin fills it in once a player is upgraded to Full and actually reported.
  federation String?

  enrollments  SeasonEnrollment[]
  signups      RoundSignup[]
  whiteEntries RoundEntry[]       @relation("WhitePlayer")
  blackEntries RoundEntry[]       @relation("BlackPlayer")
  soloEntries  RoundEntry[]       @relation("SoloPlayer")

  @@index([name])
}

model Season {
  id         Int       @id @default(autoincrement())
  name       String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  isArchived Boolean   @default(false)

  // Snapshotted at creation, not read from a live "current settings" table:
  // topValue alone determines every historical score, so it must never
  // silently shift for an archived season. repeatPairingWindow,
  // countExternalMatches, and regularByeCap only affect which entries get
  // created going forward, so they're safe to edit on the active season at
  // any time.
  topValue             Int
  repeatPairingWindow  Int
  countExternalMatches Boolean
  regularByeCap        Int

  // KNSB rating-list submission metadata for this season's internal
  // (Rapid, 25+10) competition. knsbPlannedEndDate is deliberately distinct
  // from endedAt — real submissions report the season's nominal end date
  // even mid-season, well before the season actually ends.
  knsbTournamentName String?
  knsbPlannedEndDate DateTime?

  enrollments SeasonEnrollment[]
  rounds      Round[]
}

model SeasonEnrollment {
  id            Int    @id @default(autoincrement())
  seasonId      Int
  season        Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId      Int
  player        Player @relation(fields: [playerId], references: [id])
  // Admin-entered estimate, or seeded from the prior season's final rank. Used as-is.
  startingValue Int

  @@unique([seasonId, playerId])
}

model Round {
  id          Int      @id @default(autoincrement())
  seasonId    Int
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number      Int
  date        DateTime
  // Gates PUBLIC visibility only — never gates whether entries can be edited.
  isPublished Boolean  @default(false)

  signups    RoundSignup[]
  entries    RoundEntry[]
  shareImage RoundShareImage?

  @@unique([seasonId, number])
}

// The rendered "share this round" preview image (see server/src/modules/rounds/shareImage.ts),
// regenerated on publish and on every entry-level edit to a published round —
// kept in its own table rather than a column on Round so an ordinary
// `prisma.round.findMany` (the hot path for every leaderboard/replay query)
// never pulls a PNG blob along with it. Never queried without the round it
// belongs to, so roundId doubles as its own primary key (real 1:1) instead
// of a separate id + unique index.
model RoundShareImage {
  roundId     Int      @id
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  data        Bytes
  generatedAt DateTime @default(now())
}

// The literal "Who's playing?" chip list at round-creation time, kept as its
// own audit row so "who was absent" (-> regular byes) is a plain diff against
// the season's enrolled players, not something inferred after the fact.
model RoundSignup {
  id       Int    @id @default(autoincrement())
  roundId  Int
  round    Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId Int
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([roundId, playerId])
}

model RoundEntry {
  id      Int       @id @default(autoincrement())
  roundId Int
  round   Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  kind    EntryKind

  // GAME only
  tableNumber    Int?
  whitePlayerId  Int?
  whitePlayer    Player?     @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayerId  Int?
  blackPlayer    Player?     @relation("BlackPlayer", fields: [blackPlayerId], references: [id])
  result         GameResult?
  isSelfArranged Boolean     @default(false)

  // PAIRING_BYE / REGULAR_BYE / EXTERNAL_BYE only
  soloPlayerId    Int?
  soloPlayer      Player?          @relation("SoloPlayer", fields: [soloPlayerId], references: [id])
  externalOutcome ExternalOutcome?

  // REGULAR_BYE only — true when this bye was backfilled into a round that
  // already existed before the player enrolled (see backfillMissedRounds),
  // rather than auto-materialized for an already-enrolled absent player.
  // Never counts as this player's ranked "debut" — see engine/standings.ts.
  isRetroactive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id always 1): concerns that are NOT season-scoped.
model ClubSettings {
  id                          Int     @id @default(1)
  adminPasswordHash           String
  defaultTopValue             Int     @default(120)
  defaultRepeatPairingWindow  Int     @default(6)
  defaultCountExternalMatches Boolean @default(true)
  defaultRegularByeCap        Int     @default(3)

  // Jim is always the arbiter/submitter in practice — defaults prefilled
  // into every new season's KNSB metadata rather than retyped each time.
  defaultKnsbArbiterName  String?
  defaultKnsbArbiterEmail String?
  // Prefilled into the export modal, then overwritten with whatever was
  // actually typed after each successful export — Jim reuses the same base
  // name every batch, so this saves retyping it each time.
  defaultKnsbExportFilename String @default("knsb-rapid-export")
}

model AdminSession {
  token     String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  actorName String?
}

/**
 * Append-only audit trail of admin actions — who did what, and when.
 */
model AdminActionLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  actorName String?
  method    String
  path      String
  summary   String
}
